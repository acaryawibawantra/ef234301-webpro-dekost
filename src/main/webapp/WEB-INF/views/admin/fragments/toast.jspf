<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="toast-stack" aria-live="polite" data-toast-timeout="4500">
    <c:if test="${not empty flash}">
        <c:choose>
            <c:when test="${flash.type eq 'error'}">
                <p class="toast toast--error" role="status"><c:out value="${flash.text}"/></p>
            </c:when>
            <c:when test="${flash.type eq 'warning'}">
                <p class="toast toast--warning" role="status"><c:out value="${flash.text}"/></p>
            </c:when>
            <c:otherwise>
                <p class="toast" role="status"><c:out value="${flash.text}"/></p>
            </c:otherwise>
        </c:choose>
    </c:if>
</div>
