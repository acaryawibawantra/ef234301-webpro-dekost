<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<header class="topbar">
    <div class="topbar__heading">
        <h1 class="topbar__title">
            <c:out value="${empty pageTitle ? 'Dashboard' : pageTitle}"/>
        </h1>
        <c:if test="${not empty pageSubtitle}">
            <p class="topbar__subtitle"><c:out value="${pageSubtitle}"/></p>
        </c:if>
    </div>

    <c:if test="${not empty pageActionLabel}">
        <div class="topbar__actions">
            <a class="button button--primary" href="${pageActionHref}">
                <c:out value="${pageActionLabel}"/>
            </a>
        </div>
    </c:if>
</header>
